# Render sets DATABASE_URL automatically from the vendly-db database (see render.yaml).
# Leave empty locally to use an in-process PGlite database stored in ./.pglite
DATABASE_URL=
PORT=4000
# Long random string. Render generates one from render.yaml.
JWT_SECRET=change-me
# Your Vercel URL(s), comma separated, for CORS. e.g. https://vendly.vercel.app
FRONTEND_URL=http://localhost:5173
# Public URL of this API (used in email links back to the API if needed)
APP_NAME=Vendly
# Optional: Google sign-in (OAuth 2.0 Web client ID)
GOOGLE_CLIENT_ID=
# Optional: Resend for automatic email. Without a key emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=bookings@yourdomain.com
# Protects POST /api/cron/run for an external scheduler
CRON_SECRET=change-me-too
# Protects POST /api/admin/plan (manual plan upgrades until subscription billing exists)
ADMIN_SECRET=
# Plan settings
FREE_BOOKINGS_PER_MONTH=10
